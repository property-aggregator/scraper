# RabbitMQ (docker-compose overrides RABBITMQ_HOST with "rabbitmq" for the scraper container)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=offers
RABBITMQ_EXCHANGE=property_scraper

# Scraper
REQUEST_DELAY=3.0
REQUEST_TIMEOUT=15
FIRST_PAGE_INTERVAL=10
FULL_SCRAPE_TIME=21:22
SCRAPER_MODE=worker

# Optional
# REQUEST_JITTER=3.0
# LONG_PAUSE_AFTER_MIN=40
# LONG_PAUSE_AFTER_MAX=80   # 0 disables long pauses
# LONG_PAUSE_MIN=20
# LONG_PAUSE_MAX=60
# SOURCE_PAUSE_MIN=30
# SOURCE_PAUSE_MAX=90
# FETCH_ATTEMPTS=3
# PROXY_URLS=http://user:pass@host1:port,http://user:pass@host2:port
# PROXY_COOLDOWN=300
# SOURCES_FILE=/path/to/sources.toml
